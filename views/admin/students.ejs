<%- include('../partials/admin-layout-head') %>
<% activePage = 'students'; %>
<div class="app-shell">
<%- include('../partials/admin-sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="hamburger-btn" onclick="toggleSidebar()" title="Menu"><i class="fas fa-bars"></i></button>
      <div>
        <div class="page-title">विद्यार्थी <span class="english-caption-inline">Students</span></div>
      </div>
    </div>
  </div>
  <div class="page-content">
    <div class="card">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
        <div class="card-title">
          <i class="fas fa-user-graduate"></i> 
          <span class="marathi-primary">सर्व विद्यार्थी <span class="english-caption-inline">All Students (<%= students.length %>)</span></span>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="topbar-btn btn-outline" onclick="document.getElementById('uploadModal').style.display='block'">
            <i class="fas fa-file-excel"></i> Excel Upload
          </button>
          <a href="/admin/students/add" class="topbar-btn btn-gold">
            <i class="fas fa-plus"></i> नवीन विद्यार्थी / Add Student
          </a>
        </div>
      </div>
      <div class="card-body" style="padding-bottom:0;">
        <div class="search-bar">
          <form method="GET" action="/admin/students" style="display:flex;gap:12px;width:100%;flex-wrap:wrap;">
            <div class="search-wrap">
              <i class="fas fa-search search-icon"></i>
              <input type="text" name="search" class="input" placeholder="नाव किंवा ID शोधा / Search by name or ID..." value="<%= search %>"/>
            </div>
            <select name="classFilter" class="select" style="width:180px;">
              <option value="">सर्व वर्ग / All Classes</option>
              <% [['१ली','1st'],['२री','2nd'],['३री','3rd'],['४थी','4th'],['५वी','5th'],['६वी','6th'],['७वी','7th'],['८वी','8th'],['९वी','9th'],['१०वी','10th']].forEach(([mr,en]) => { %>
              <option value="<%= mr %>" <%= classFilter === mr ? 'selected' : '' %>><%= mr %> (<%= en %>)</option>
              <% }) %>
            </select>
            <button type="submit" class="topbar-btn btn-gold"><i class="fas fa-filter"></i> फिल्टर / Filter</button>
            <a href="/admin/students" class="topbar-btn btn-outline">साफ करा / Clear</a>
          </form>
        </div>
      </div>
      <div class="table-container">
        <% if(students.length === 0) { %>
          <div class="table-empty"><i class="fas fa-users-slash" style="font-size:40px;display:block;margin-bottom:12px;color:#94a3b8;"></i>कोणताही विद्यार्थी सापडला नाही<br><small>No students found</small></div>
        <% } else { %>
        <table class="mobile-cards">
          <thead><tr>
            <th>क्र. / Roll No</th>
            <th>नाव / Name</th>
            <th>वर्ग / Class</th>
            <th>प्रवेश ID / Enrollment</th>
            <th>वडिलांचे नाव / Father's Name</th>
            <th>जोडले / Added By</th>
            <th>क्रिया / Action</th>
          </tr></thead>
          <tbody>
            <% students.forEach(s => { %>
            <tr>
              <td data-label="क्र. / Roll No"><span class="badge badge-navy"><%= s.rollNo || '—' %></span></td>
              <td data-label="नाव / Name">
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#0f1f3d,#1d3461);display:flex;align-items:center;justify-content:center;color:#c9a84c;font-size:12px;font-weight:700;flex-shrink:0;overflow:hidden;">
                    <% if(s.photo) { %><img src="<%= s.photo %>" style="width:100%;height:100%;object-fit:cover;"/><% } else { %><%= s.name.charAt(0) %><% } %>
                  </div>
                  <strong style="font-family:'Noto Sans Devanagari',sans-serif;"><%= s.name %></strong>
                </div>
              </td>
              <td data-label="वर्ग / Class"><span class="badge badge-gold">वर्ग <%= s.currentClass %><% if(s.currentSection) { %> - <%= s.currentSection %><% } %></span></td>
              <td data-label="प्रवेश ID / Enrollment"><code style="font-size:11px;color:#0f1f3d;"><%= s.enrollmentId %></code></td>
              <td data-label="वडिलांचे नाव / Father's Name"><%= s.fatherName || '—' %></td>
              <td data-label="जोडले / Added By"><%= s.addedBy ? s.addedBy.name : '—' %></td>
              <td data-label="क्रिया / Action">
                <div style="display:flex; gap:6px;">
                  <a href="/admin/students/<%= s._id %>" class="topbar-btn btn-outline" style="padding:8px 12px;font-size:12px;">
                    <i class="fas fa-eye"></i> View
                  </a>
                  <a href="/admin/students/edit/<%= s._id %>" class="topbar-btn btn-outline" style="padding:8px 12px;font-size:12px;">
                    <i class="fas fa-edit"></i> Edit
                  </a>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Excel Upload Modal -->
<div id="uploadModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
  <div style="background:#fff; width:400px; margin:100px auto; border-radius:12px; padding:24px; box-shadow:0 10px 30px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h3 style="margin:0; font-family:'Noto Sans Devanagari',sans-serif;">Excel द्वारे विद्यार्थी अपलोड करा</h3>
      <button onclick="document.getElementById('uploadModal').style.display='none'" style="background:none; border:none; font-size:20px; cursor:pointer;">&times;</button>
    </div>
    <form action="/admin/students/upload" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; margin-bottom:8px;">Excel File (.xlsx)</label>
        <input type="file" name="excelFile" accept=".xlsx, .xls" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:8px;">
      </div>
      <div style="font-size:12px; color:#64748b; margin-bottom:16px;">
        <p>Your Excel file should have columns exactly matching these (case sensitive):</p>
        <code>name, currentClass, currentSection, rollNo, gender, dateOfBirth, fatherName, motherName, parentContact, aadharNo, category, religion, admissionDate, lastExamAppeared, lastExamResult</code>
      </div>
      <button type="submit" class="btn-login" style="padding:10px;">अॅपलोड करा / Upload</button>
    </form>
  </div>
</div>
</div>
<script>
function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('sidebarOverlay').classList.toggle('show'); }
function closeSidebar(){ document.getElementById('sidebar').classList.remove('open'); document.getElementById('sidebarOverlay').classList.remove('show'); }
</script>
</body></html>
