<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>शिक्षक नोंदणी | Teacher Registration</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'DM Sans',sans-serif;background:linear-gradient(135deg,#0f1f3d 0%,#1a237e 50%,#0f1f3d 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
.login-container{width:100%;max-width:500px;}
.school-header{text-align:center;margin-bottom:24px;color:#fff;}
.school-icon{width:60px;height:60px;background:linear-gradient(135deg,#c9a84c,#e6c668);border-radius:16px;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 8px 24px rgba(201,168,76,.4);}
.school-name-mar{font-family:'Noto Sans Devanagari',sans-serif;font-size:20px;font-weight:700;color:#fff;line-height:1.3;}
.login-card{background:#fff;border-radius:20px;padding:32px;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.form-title{text-align:center;font-size:18px;font-weight:700;color:#0f1f3d;margin-bottom:24px;}
.form-label{display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;}
.input-wrap{position:relative;margin-bottom:18px;}
.input-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:15px;}
.form-input{width:100%;padding:12px 14px 12px 42px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:14px;color:#0f1f3d;background:#f8fafc;transition:all .2s;font-family:'DM Sans',sans-serif;}
.form-input:focus{outline:none;border-color:#1a237e;background:#fff;box-shadow:0 0 0 3px rgba(26,35,126,.08);}
.btn-login{width:100%;padding:14px;background:linear-gradient(135deg,#0f1f3d,#1a237e);color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;letter-spacing:.5px;transition:all .2s;font-family:'DM Sans',sans-serif;margin-top:10px;}
.btn-login:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(26,35,126,.4);}
.error-msg{background:#fff5f5;border:1px solid #fecaca;color:#c62828;padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:18px;display:flex;align-items:center;gap:8px;}
.success-msg{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;padding:12px 16px;border-radius:10px;font-size:13px;margin-bottom:18px;display:flex;align-items:center;gap:8px;}
</style>
</head>
<body>
<div class="login-container">
  <div class="school-header">
    <div class="school-icon">🎓</div>
    <div class="school-name-mar">तुलजाभवानी माध्यमिक विद्यालय</div>
  </div>

  <div class="login-card">
    <div class="form-title">नवीन शिक्षक नोंदणी / Teacher Registration</div>
    
    <% if(typeof error !== 'undefined' && error) { %>
      <div class="error-msg"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>
    
    <% if(typeof message !== 'undefined' && message) { %>
      <div class="success-msg"><i class="fas fa-check-circle"></i> <%= message %></div>
      <div style="text-align:center;margin-top:20px;">
        <a href="/auth/login" style="font-size:14px;font-weight:600;color:#1a237e;text-decoration:none;"><i class="fas fa-arrow-left"></i> लॉगिन पानावर जा (Go to Login)</a>
      </div>
    <% } else { %>
      <form method="POST" action="/auth/register-teacher">
        <div>
          <label class="form-label">पूर्ण नाव / Full Name <span style="color:red">*</span></label>
          <div class="input-wrap">
            <i class="fas fa-user input-icon"></i>
            <input type="text" name="name" class="form-input" placeholder="Your full name" required/>
          </div>
        </div>
        
        <div>
          <label class="form-label">Email (ईमेल) <span style="color:red">*</span></label>
          <div class="input-wrap">
            <i class="fas fa-envelope input-icon"></i>
            <input type="email" name="email" class="form-input" placeholder="teacher@school.com" required/>
          </div>
        </div>
        
        <div>
          <label class="form-label">मोबाईल नंबर / Phone Number <span style="color:red">*</span></label>
          <div class="input-wrap">
            <i class="fas fa-phone input-icon"></i>
            <input type="text" name="phone" class="form-input" placeholder="9876543210" required/>
          </div>
        </div>

        <div>
          <label class="form-label">पासवर्ड / Password <span style="color:red">*</span></label>
          <div class="input-wrap">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" name="password" class="form-input" placeholder="••••••••" required/>
          </div>
        </div>
        
        <div>
          <label class="form-label">विषय / Subject Specialization</label>
          <div class="input-wrap">
            <i class="fas fa-book input-icon"></i>
            <input type="text" name="subject" class="form-input" placeholder="e.g. Mathematics, Science"/>
          </div>
        </div>

        <button type="submit" class="btn-login">नोंदणी करा / Register</button>
        
        <div style="text-align:center;margin-top:20px;">
          <a href="/auth/login?role=teacher" style="font-size:13px;font-weight:600;color:#64748b;text-decoration:none;">आधीच खाते आहे? लॉगिन करा (Already registered? Login)</a>
        </div>
      </form>
    <% } %>
  </div>
</div>
</body>
</html>
